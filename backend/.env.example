PORT=5001
FRONTEND_ORIGIN=http://localhost:5173
TRANSIT_MODE=demo
CACHE_TTL_SECONDS=30
# Backend only: absolute path to a Firebase service-account JSON file outside this repo.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Backend only: request a key at https://register.developer.obanyc.com/.
MTA_BUS_TIME_API_KEY=
# Maximum age (seconds) of Bus Time deliveries / per-vehicle observations.
BUS_MAX_AGE_SECONDS=120
BUS_VEHICLE_MAX_AGE_SECONDS=120

# Journeys: 1 allows the documented bus stop <-> subway station walks; 0 returns 503 for cross-mode trips.
JOURNEY_CROSS_MODE_WALKS=1

# B APIs: source HTTP-response age limit for equipment snapshots (seconds).
EQUIPMENT_MAX_AGE_SECONDS=600
# Optional stable random secret for private-list cursors across worker/restart boundaries.
# Leave empty for a single-process development server (cursors expire on restart).
PAGINATION_SIGNING_KEY=
